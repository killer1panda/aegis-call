{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AegisCall",
  "version": "1.0.0",
  "identifier": "com.aegis.call",
  "build": {
    "frontendDist": "../packages/client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @aegis/client",
    "beforeBuildCommand": "npm run build -w @aegis/client"
  },
  "app": {
    "windows": [
      {
        "title": "AegisCall — Zero-Trust Encrypted WebRTC",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: mediastream:; connect-src 'self' ws: wss: http: https:; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }

  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/killer1panda/aegis-call/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNzJBRTY4M0Q5QTYyOUUKUldUSkVzYUh6SEl0V216b2p4S04xOHlBdmx0Uk8vU3Z2K0J2U1Z5bVpuZ0k0UGc9PQo="
    }
  }
}
