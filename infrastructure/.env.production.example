# ==============================================================================
# 🛡️ AegisCall Production Sovereign Self-Hosting Environment Configuration
# ==============================================================================

# Public Fully Qualified Domain Name (FQDN)
DOMAIN_NAME=aegiscall.example.com

# Let's Encrypt / ACME TLS Notification Email
ACME_EMAIL=security@example.com

# Coturn TURN Static Auth Secret (RFC 5766 REST API)
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=replace_with_a_secure_random_64_hex_character_secret

# TURN Realm
TURN_REALM=turn.example.com

# TURN Server URLs for Client ICE Resolution (Comma-separated)
TURN_SERVER_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478
