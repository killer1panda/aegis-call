# ==============================================================================
# 🛡️ AegisCall Sovereign Self-Hosting Master Production Environment Template
# File: infrastructure/.env.production
# Security Notice: chmod 600 infrastructure/.env.production (Never commit real secrets to git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Web Gateway & ACME TLS (Caddy 2 & Fastify)
# ------------------------------------------------------------------------------
# Public Fully Qualified Domain Name (FQDN)
DOMAIN_NAME=aegiscall.example.com

# Let's Encrypt / ZeroSSL TLS Certificate Notification & Account Recovery Email
ACME_EMAIL=admin@example.com

# Signaling & SFU Server Internal Port (Default: 4000)
PORT=4000

# Node Environment Mode (enforces production hardening & secrets enforcement)
NODE_ENV=production

# (Optional) Custom TLS Certificate & Private Key (if not using automatic ACME)
# CUSTOM_SSL_CERT_PATH=/etc/ssl/certs/aegiscall.crt
# CUSTOM_SSL_KEY_PATH=/etc/ssl/private/aegiscall.key


# ------------------------------------------------------------------------------
# 2. Coturn STUN/TURN/TURNS WebRTC Media Relay (Host Networking)
# ------------------------------------------------------------------------------
# RFC 5766 REST API Static Auth Secret (32 bytes / 64 hex characters)
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=replace_with_a_secure_random_64_hex_character_secret

# TURN Realm (matches public domain / SNI)
TURN_REALM=turn.example.com

# TURN Server URLs for Client ICE Resolution (Comma-separated)
TURN_SERVER_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478


# ------------------------------------------------------------------------------
# 3. Apple iOS VoIP Push Notifications (APNs - Native CallKit Wakeup)
# ------------------------------------------------------------------------------
# 10-character Apple Push Notification Key ID
APNS_KEY_ID=ABC1234XYZ

# 10-character Apple Developer Team ID
APNS_TEAM_ID=DEF5678UVW

# iOS App Bundle Identifier
APNS_BUNDLE_ID=io.aegiscall.secure

# VoIP Push Notification Topic
APNS_VOIP_TOPIC=io.aegiscall.secure.voip

# Target APNs Gateway: 'production' (App Store / TestFlight) or 'development' (Xcode sandbox)
APNS_ENVIRONMENT=production

# Path to the AuthKey_XXXXXXXXXX.p8 private key file
APNS_P8_PATH=/etc/aegis/apns/AuthKey_ABC1234XYZ.p8


# ------------------------------------------------------------------------------
# 4. Android VoIP Push Notifications (Google FCM v1 - ConnectionService Wakeup)
# ------------------------------------------------------------------------------
# Firebase / Google Cloud Project ID
FCM_PROJECT_ID=aegis-call-production

# Absolute path to Google Cloud Service Account JSON file (Firebase Admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=/etc/aegis/fcm/service-account.json


# ------------------------------------------------------------------------------
# 5. Carrier PSTN Telephony (RFC 3261 SIP Trunking Gateway)
# ------------------------------------------------------------------------------
# SIP Trunking Provider Registrar / SBC Hostname (e.g. sip.telnyx.com, sip.twilio.com)
SIP_TRUNK_HOST=sip.carrier.com

# SIP Signaling Port (Default: 5060 for UDP/TCP, 5061 for TLS)
SIP_TRUNK_PORT=5060

# SIP Digest Authentication Username / Trunk ID
SIP_AUTH_USERNAME=aegis_sip_trunk_user

# SIP Digest Authentication Password
SIP_AUTH_PASSWORD=your_sip_trunk_complex_password

# Outbound Caller ID / DID Telephone Number in E.164 Format
SIP_OUTBOUND_CALLER_ID=+12025550199

# SIP Digest Realm (Defaults to SIP_TRUNK_HOST if omitted)
SIP_REALM=sip.carrier.com


# ------------------------------------------------------------------------------
# 6. FIDO2 / WebAuthn Hardware Authenticator Roots
# ------------------------------------------------------------------------------
# Relying Party Identifier (must match web hostname, e.g. aegiscall.example.com)
WEBAUTHN_RP_ID=aegiscall.example.com

# Human-readable Relying Party Name shown on security keys (YubiKey / Touch ID)
WEBAUTHN_RP_NAME=AegisCall Sovereign Hardware Gate

# Canonical Origin URL
WEBAUTHN_ORIGIN=https://aegiscall.example.com


# ------------------------------------------------------------------------------
# 7. Matrix 2.0 MSC3401 & MatrixRTC Interoperability (Optional Federation)
# ------------------------------------------------------------------------------
# Matrix Homeserver Base URL
MATRIX_HOMESERVER_URL=https://matrix.example.com

# Matrix Server Delegation Domain
MATRIX_SERVER_NAME=example.com

# Matrix Bot User ID used to publish m.call.member state events
MATRIX_BOT_USER_ID=@aegis-bridge:example.com

# Matrix Access Token for Bot Account (from /_matrix/client/v3/login)
MATRIX_ACCESS_TOKEN=syt_aegis_access_token_secret


# ------------------------------------------------------------------------------
# 8. Oblivious HTTP (OHTTP) Relaying (Optional IP-Blinding Hops)
# ------------------------------------------------------------------------------
# OHTTP Blind Relay URL (e.g. Cloudflare or Fastly OHTTP relay)
OHTTP_RELAY_URL=https://relay.ohttp.cloudflare.com/

# OHTTP Gateway URL
OHTTP_GATEWAY_URL=https://gateway.ohttp.example.com/bhttp

# Base64 or Hex HPKE Key Configuration Binary (RFC 9458)
OHTTP_KEY_CONFIG=


# ------------------------------------------------------------------------------
# 9. System Auditing, Metrics & Telemetry
# ------------------------------------------------------------------------------
# Secret Bearer Token for Prometheus /metrics endpoint scraping
# Generate with: openssl rand -hex 16
METRICS_AUTH_TOKEN=replace_with_random_32_hex_token

# Secret HMAC Key for SHA-256 Hash Chaining of Immutable Security Audit Logs
# Generate with: openssl rand -hex 32
AUDIT_LOG_HMAC_KEY=replace_with_random_64_hex_key

# (Optional) Self-hosted Sentry / GlitchTip Error Reporting DSN
# SENTRY_DSN=https://pubkey@sentry.example.com/1
